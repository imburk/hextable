":4,"abil":{"str":18,"dex":14,"con":16,"int":8,"wis":12,"cha":10},"feats":[{"id":"rage","name":"Rage","tier":"auto","text":"As a Bonus Action, unless wearing Heavy armor, enter a Rage: Resistance to Bludgeoning, Piercing and Slashing damage; the Rage Damage bonus to damage with Strength attacks; Advantage on Strength checks and saves; no spells or Concentration. It lasts to the end of your next turn and is extended by attacking an enemy, forcing an enemy to save, or a Bonus Action, for up to 10 minutes. Ends early when you are Incapacitated. One use back on a Short Rest, all on a Long Rest.","uses":{"max":4,"recharge":"long","short":1},"action":{"time":"bonus","target":{"self":true},"duration":"10 minutes","renew":true,"noSpells":true,"unless":"heavy","endsWhenIncapacitated":true,"effects":[{"modifier":{"on":"damage.taken","op":"resist","types":["bludgeoning","piercing","slashing"]},"ends":{"on":"turnEnd"}},{"modifier":{"on":"damage.dealt","op":"add","value":3,"when":["attack.hit","attack.str"]},"ends":{"on":"turnEnd"}},{"modifier":{"on":"check","op":"advantage","scope":{"ability":"str"}},"ends":{"on":"turnEnd"}},{"modifier":{"on":"save.str","op":"advantage"},"ends":{"on":"turnEnd"}}]}},{"id":"unarmored-defense","name":"Unarmored Defense","tier":"auto","text":"Without armor, your base Armor Class is 10 + Dexterity and Constitution modifiers. A Shield still adds."},{"id":"weapon-mastery","name":"Weapon Mastery","tier":"manual","text":"Use the mastery properties of two kinds of weapons you choose (more at higher levels). The engine does not apply mastery properties yet."},{"id":"danger-sense","name":"Danger Sense","tier":"auto","text":"Advantage on Dexterity saving throws unless you are Incapacitated.","modifiers":[{"on":"save.dex","op":"advantage","when":["self.notIncapacitated"]}]},{"id":"reckless-attack","name":"Reckless Attack","tier":"auto","text":"When you make your first attack roll on your turn, you can attack recklessly: Advantage on attack rolls using Strength until the start of your next turn, and attack rolls against you have Advantage until then.","action":{"time":"free","firstAttack":true,"target":{"self":true},"duration":"1 round","effects":[{"modifier":{"on":"attack.roll","op":"advantage","when":["attack.str"]}},{"modifier":{"on":"attack.received","op":"advantage"}}]}},{"id":"primal-knowledge","name":"Primal Knowledge","tier":"assist","text":"Gain one more skill from the Barbarian list. While raging, Acrobatics, Intimidation, Perception, Stealth and Survival checks can be made as Strength checks (the DM applies that part)."},{"id":"frenzy","name":"Frenzy","tier":"manual","text":"With Reckless Attack while raging, the first target you hit on your turn with a Strength attack takes extra d6s equal to your Rage Damage bonus. The DM applies it."},{"id":"ability-score-improvement-4","name":"Ability Score Improvement","tier":"auto","text":"Take the Ability Score Improvement feat or another feat you qualify for (the sheet's feats). Without one, the scores entered on the sheet are taken as they stand."},{"id":"extra-attack","name":"Extra Attack","tier":"auto","text":"Attack twice when you take the Attack action."},{"id":"fast-movement","name":"Fast Movement","tier":"auto","text":"+10 feet Speed while not wearing Heavy armor."},{"id":"mindless-rage","name":"Mindless Rage","tier":"manual","text":"Immune to Charmed and Frightened while raging; entering Rage ends them. The DM applies it."},{"id":"feral-instinct","name":"Feral Instinct","tier":"auto","text":"Advantage on Initiative rolls.","modifiers":[{"on":"initiative","op":"advantage"}]},{"id":"instinctive-pounce","name":"Instinctive Pounce","tier":"manual","text":"As part of the Bonus Action to enter Rage, move up to half your Speed. The DM moves you."},{"id":"ability-score-improvement-8","name":"Ability Score Improvement","tier":"auto","text":"Take the Ability Score Improvement feat or another feat you qualify for (the sheet's feats). Without one, the scores entered on the sheet are taken as they stand."},{"id":"brutal-strike","name":"Brutal Strike","tier":"manual","text":"With Reckless Attack, forgo Advantage on one Strength attack; on a hit it deals 1d10 more and a Forceful Blow or Hamstring Blow. The engine cannot take that choice; the DM applies it."},{"id":"retaliation","name":"Retaliation","tier":"manual","text":"When a creature within 5 feet damages you, use your Reaction to make a melee attack against it. Reactions are not prompted yet."},{"id":"relentless-rage","name":"Relentless Rage","tier":"manual","text":"Dropping to 0 Hit Points while raging, make a DC 10 Constitution save (DC +5 each later use, reset by a rest) to have Hit Points equal to twice your Barbarian level instead. The DM applies it."}],"hitDie":12,"armour":"none","maxHp":115,"slotsMax":{},"uses":{"secondWind":0,"rage":3},"hd":11,"cond":{},"death":{"s":0,"f":0},"dead":false,"reactionUsed":false,"id":"hero","pos":{"q":0,"r":0,"z":0},"xp":85000,"sheet":{"name":"Ur","class":"barbarian","level":11,"subclass":"berserker","abilities":{"str":18,"dex":14,"con":16,"int":8,"wis":12,"cha":10},"skills":["athletics","survival","perception"],"weapons":["greataxe"]}},"m11":{"kind":"npc","side":"foe","owner":null,"level":0,"size":"small","speeds":{},"senses":{"darkvision":60},"saveProf":[],"saveBonus":{},"skills":[],"expertise":[],"tools":[],"skillBonus":{"stealth":6},"features":{"nimbleEscape":true},"attacks":[{"id":"scimitar","name":"Scimitar","type":"melee","bonus":4,"damage":"1d6+2","dtype":"slashing","reach":5,"bonusOnAdv":"1d4"},{"id":"shortbow","name":"Shortbow","type":"ranged","bonus":4,"damage":"1d6+2","dtype":"piercing","range":[80,320],"bonusOnAdv":"1d4"}],"spells":[],"slots":{},"resist":[],"vuln":[],"immune":[],"gear":[],"name":"Goblin Warrior 1","ac":15,"hp":10,"speed":30,"initBonus":2,"abil":{"str":8,"dex":15,"con":10,"int":10,"wis":8,"cha":8},"prof":2,"actions":[{"id":"scimitar","name":"Scimitar","target":{"creature":{"reach":5}},"effects":[{"attack":"melee","